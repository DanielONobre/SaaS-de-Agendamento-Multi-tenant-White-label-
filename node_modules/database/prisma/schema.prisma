// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
}

model Service {
  id          String @id @default(uuid())
  tenantId    String
  name        String
  durationMin Int
  price       Float
}

model Professional {
  id           String @id @default(uuid())
  tenantId     String
  name         String
  availability Json
}

model Appointment {
  id             String   @id @default(uuid())
  tenantId       String
  startTime      DateTime
  endTime        DateTime
  status         String
  professionalId String
}
